# Copy this to .env.local and fill in your values
# Get these from: Supabase → Project Settings → API

VITE_USE_LOCAL_MODE=false
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic API key for Claude integration
# Get this from: console.anthropic.com → API Keys
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Service role key — NEVER prefix with VITE_, never expose to frontend
# Only used in server-side scripts (onboarding, migrations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PowerSync (offline-first sync) — CLI-only, never prefix PS_ADMIN_TOKEN with VITE_
# Generate a PAT at: dashboard.powersync.com/account/access-tokens
PS_ADMIN_TOKEN=jpt_...
INSTANCE_ID=your-powersync-instance-id
VITE_POWERSYNC_URL=https://your-powersync-instance-id.powersync.journeyapps.com
